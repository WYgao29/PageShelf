{
  "name": "html-conversation-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "service:install": "node src/service.js install",
    "service:status": "node src/service.js status",
    "service:stop": "node src/service.js stop",
    "service:uninstall": "node src/service.js uninstall",
    "test": "node --test test/*.test.js",
    "test:ui": "vitest run",
    "check": "node scripts/check-vendor.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "benchmark:search": "node scripts/benchmark-search.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "build:ui": "tsc -p tsconfig.ui.json --noEmit && vite build && node scripts/build-notices.mjs",
    "build:electron": "tsc -p tsconfig.electron.json --noEmit && node scripts/build-electron.mjs",
    "build:desktop": "npm run build:ui && npm run build:electron",
    "test:electron": "node scripts/electron-e2e.mjs",
    "icons": "bash scripts/make-icon.sh",
    "package:mac": "npm run build:desktop && npm run icons && node scripts/package-mac.mjs",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "productName": "PageShelf",
  "description": "本机 HTML、MHTML 与 Markdown 资料阅读和搜索"
}
