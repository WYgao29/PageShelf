{
  "name": "html-conversation-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "build": "tsc -p tsconfig.ui.json --noEmit && vite build && node scripts/build-notices.mjs && tsc -p tsconfig.electron.json --noEmit && node scripts/build-electron.mjs",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check-vendor.mjs",
    "icons": "bash scripts/make-icon.sh",
    "package:mac": "npm run build && npm run icons && node scripts/package-mac.mjs",
    "benchmark:search": "node scripts/benchmark-search.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "productName": "PageShelf",
  "description": "本机 HTML、MHTML 与 Markdown 资料阅读和搜索"
}
